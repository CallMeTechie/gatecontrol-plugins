{
  "id": "gatecontrol-hello",
  "name": {
    "de": "Hallo Welt",
    "en": "Hello World"
  },
  "version": "1.1.0",
  "publisher": "CallMeTechie",
  "description": {
    "de": "Beispiel-Plugin: zeigt die Host-API (Seiten, Portal-Tab, Einstellungen, Speicher, Netzwerkziele) und einen Edge-Teil, der auf Gateways läuft. Wird nicht veröffentlicht.",
    "en": "Example plugin showing the host API (pages, portal tab, settings, storage, network targets) and an edge part that runs on gateways. Not released."
  },
  "gatecontrol": ">=1.228.0",
  "entry": "server/index.js",
  "edge": {
    "entry": "edge/index.js",
    "minGateway": "1.19.0",
    "memoryMb": 32,
    "capabilities": {}
  },
  "permissions": {
    "network": {
      "internet": [
        "api.example.com:443",
        "*.cloud.example"
      ],
      "homeTargets": [
        {
          "id": "gateway",
          "label": {
            "de": "Gateway",
            "en": "Gateway"
          },
          "protocols": [
            "http"
          ]
        },
        {
          "id": "device",
          "label": {
            "de": "Gerät",
            "en": "Device"
          },
          "protocols": [
            "tcp:6444",
            "udp:6445"
          ],
          "multiple": true
        }
      ],
      "localDiscovery": {
        "udp": [
          6445,
          20086
        ]
      }
    },
    "storage": true,
    "portal": true,
    "users": true,
    "notify": true,
    "background": {
      "intervalSeconds": 60
    }
  },
  "ui": {
    "nav": {
      "label": {
        "de": "Hallo",
        "en": "Hello"
      },
      "icon": "M4 12h16M12 4v16"
    },
    "pages": [
      {
        "id": "main",
        "title": {
          "de": "Hallo",
          "en": "Hello"
        }
      },
      {
        "id": "about",
        "title": {
          "de": "Über",
          "en": "About"
        }
      },
      {
        "id": "gateways",
        "title": {
          "de": "Gateways",
          "en": "Gateways"
        }
      }
    ],
    "settingsPage": "gateways",
    "settings": [
      {
        "key": "greeting",
        "type": "text",
        "label": {
          "de": "Begrüßung",
          "en": "Greeting"
        },
        "default": "Hallo"
      },
      {
        "key": "loud",
        "type": "boolean",
        "label": {
          "de": "Laut",
          "en": "Loud"
        },
        "default": false
      },
      {
        "key": "repeat",
        "type": "number",
        "label": {
          "de": "Wiederholungen",
          "en": "Repeats"
        },
        "min": 1,
        "max": 5,
        "default": 1
      },
      {
        "key": "token",
        "type": "secret",
        "label": {
          "de": "API-Token",
          "en": "API token"
        }
      }
    ],
    "portal": {
      "label": {
        "de": "Hallo",
        "en": "Hello"
      },
      "icon": "M4 12h16"
    }
  },
  "license": {
    "required": false
  },
  "migrations": "migrations"
}
