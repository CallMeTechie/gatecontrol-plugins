{
  "id": "gatecontrol-messenger",
  "name": {
    "de": "Messenger",
    "en": "Messenger"
  },
  "version": "1.9.2",
  "publisher": "CallMeTechie",
  "description": {
    "de": "Chats zwischen den GateControl-Konten – in der GateControl-App (eigener Tab „Chats“), im Windows-Client und im Portal: Einzel- und Gruppenchats mit Text, Bildern, Videos, Sprachnachrichten, Dateien und Standort, Antworten mit Zitat, Reaktionen, Bearbeiten und Löschen, Lesebestätigungen, „schreibt …“, selbstlöschende Chats und Push mit Antwortfeld. Neu: Status und Storys, Abstimmungen, Termine mit Zusagen, Live-Ankunft und Haus-Aktionen im Chat. Alles bleibt auf dem eigenen Server, Texte verschlüsselt gespeichert; Administratoren können private Chats nicht lesen.",
    "en": "Chats between the GateControl accounts – in the GateControl app (own tab “Chats”), the Windows client and the portal: direct and group chats with text, pictures, videos, voice messages, files and location, replies with quote, reactions, editing and deleting, read receipts, “typing …”, disappearing chats and pushes with a reply field. New: status and stories, polls, events with RSVPs, live arrival and home actions in chats. Everything stays on your own server, texts stored encrypted; administrators cannot read private chats."
  },
  "gatecontrol": ">=1.193.0",
  "entry": "server/index.js",
  "permissions": {
    "storage": true,
    "users": true,
    "app": true,
    "portal": true,
    "notify": true,
    "notifySink": true,
    "events": true,
    "actions": {
      "interactive": true
    },
    "groups": "read",
    "services": [
      "gatecontrol-familie:list_add",
      "gatecontrol-familie:calendar_add",
      "gatecontrol-familie:calendar_upsert",
      "gatecontrol-familie:calendar_remove",
      "gatecontrol-familie:places",
      "gatecontrol-familie:family_roles"
    ],
    "background": {
      "intervalSeconds": 60
    }
  },
  "media": {
    "maxBytes": 26214400,
    "types": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "audio/ogg",
      "audio/mp4",
      "audio/aac",
      "audio/mpeg",
      "audio/webm",
      "video/mp4",
      "application/pdf",
      "application/zip",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "application/vnd.oasis.opendocument.text",
      "application/vnd.oasis.opendocument.spreadsheet",
      "application/octet-stream",
      "text/plain",
      "text/csv",
      "text/calendar",
      "text/vcard"
    ],
    "quotaDefault": "10GB",
    "handOverMaxBytes": 2147483648
  },
  "services": {
    "provides": {
      "send_message": {
        "label": {
          "de": "Chat-Nachricht senden",
          "en": "Send a chat message"
        }
      },
      "sync_group": {
        "label": {
          "de": "Gruppe abgleichen",
          "en": "Keep a group in sync"
        }
      },
      "release_group": {
        "label": {
          "de": "Gruppe freigeben",
          "en": "Hand a group back"
        }
      },
      "set_place_status": {
        "label": {
          "de": "Ort im Status anzeigen",
          "en": "Show the place in the status"
        }
      },
      "send_file": {
        "label": {
          "de": "Datei als Nachricht senden",
          "en": "Send a file as a message"
        }
      }
    }
  },
  "ui": {
    "nav": {
      "label": {
        "de": "Messenger",
        "en": "Messenger"
      },
      "icon": "M4 5h16v11H9l-5 4z"
    },
    "pages": [
      {
        "id": "overview",
        "title": {
          "de": "Übersicht",
          "en": "Overview"
        }
      },
      {
        "id": "log",
        "title": {
          "de": "Protokoll",
          "en": "Log"
        }
      }
    ],
    "portal": {
      "label": {
        "de": "Chats",
        "en": "Chats"
      },
      "icon": "M4 5h16v11H9l-5 4z"
    },
    "app": {
      "label": {
        "de": "Chats",
        "en": "Chats"
      },
      "icon": "M4 5h16v11H9l-5 4z"
    },
    "maps": true,
    "geolocation": true,
    "inbox": true
  },
  "license": {
    "required": true
  },
  "migrations": "migrations",
  "notifyTopics": [
    {
      "id": "message",
      "label": {
        "de": "Chat-Nachrichten",
        "en": "Chat messages"
      },
      "chat": true,
      "default": true
    },
    {
      "id": "status",
      "label": {
        "de": "Status-Zusammenfassung",
        "en": "Status digest"
      },
      "default": false
    }
  ]
}
