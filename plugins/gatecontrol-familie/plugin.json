{
  "id": "gatecontrol-familie",
  "name": {
    "de": "Familie",
    "en": "Family"
  },
  "version": "1.8.0",
  "publisher": "CallMeTechie",
  "description": {
    "de": "Die Familie in der GateControl-App und im Portal: gemeinsame Einkaufslisten (offline nutzbar), Aufgaben mit Erinnerung und Sternen für Kinder, Termine und Geburtstage, Abholen & Fahrten („Wer holt Tim?“), Notfall-Karte, Kinder orten auf Anfrage (das Kind sieht jede Abfrage, endet mit 18), „Bin angekommen“ und SOS, Orts-Erinnerungen, Taschengeld (nur Buchhaltung), Wunschlisten, Haushaltsbuch, Pinnwand & Packlisten, Essensplan, Anwesenheit mit Smart-Home-Regeln (nur mit Zustimmung) und ein Dashboard für ein Wand-Tablet. Alles bleibt auf dem eigenen Server.",
    "en": "The family in the GateControl app and the portal: shared shopping lists (usable offline), tasks with reminders and stars for children, dates and birthdays, pick-ups & rides (“Who picks up Tim?”), an emergency card, locating children on request (the child sees every request, ends at 18), “I’ve arrived” and SOS, place reminders, pocket money (bookkeeping only), wishlists, a household book, pinboard & packing lists, a meal plan, presence with smart home rules (only with consent) and a dashboard for a wall tablet. Everything stays on your own server."
  },
  "gatecontrol": ">=1.173.0",
  "entry": "server/index.js",
  "permissions": {
    "storage": true,
    "portal": true,
    "users": true,
    "app": true,
    "notify": {
      "perHour": 120
    },
    "background": {
      "intervalSeconds": 60
    },
    "kiosk": true,
    "actions": true,
    "services": [
      "gatecontrol-messenger:sync_group",
      "gatecontrol-messenger:send_message",
      "gatecontrol-messenger:release_group",
      "gatecontrol-messenger:set_place_status"
    ]
  },
  "services": {
    "provides": {
      "list_add": {
        "label": {
          "de": "Auf die Einkaufsliste setzen",
          "en": "Add to the shopping list"
        }
      },
      "calendar_add": {
        "label": {
          "de": "Termin anlegen",
          "en": "Add a date"
        }
      },
      "calendar_upsert": {
        "label": {
          "de": "Termin aus dem Chat abgleichen",
          "en": "Keep a date from the chat in step"
        }
      },
      "calendar_remove": {
        "label": {
          "de": "Termin aus dem Chat entfernen",
          "en": "Remove a date from the chat"
        }
      },
      "places": {
        "label": {
          "de": "Orte der Familie",
          "en": "Family places"
        }
      }
    }
  },
  "ui": {
    "nav": {
      "label": {
        "de": "Familie",
        "en": "Family"
      },
      "icon": "M3 11l9-7 9 7M5 10v10h14V10M10 20v-5h4v5"
    },
    "pages": [
      {
        "id": "members",
        "title": {
          "de": "Mitglieder & Ortung",
          "en": "Members & locating"
        }
      },
      {
        "id": "modules",
        "title": {
          "de": "Funktionen",
          "en": "Features"
        }
      },
      {
        "id": "presence",
        "title": {
          "de": "Anwesenheit & Smart Home",
          "en": "Presence & smart home"
        }
      },
      {
        "id": "log",
        "title": {
          "de": "Protokoll",
          "en": "Log"
        }
      }
    ],
    "settings": [
      {
        "key": "timezone",
        "type": "text",
        "label": {
          "de": "Zeitzone",
          "en": "Time zone"
        },
        "help": {
          "de": "IANA-Name, z. B. Europe/Berlin – für Fälligkeiten, Erinnerungen, Geburtstage und Tagesgrenzen. Leer = Zeitzone des Servers.",
          "en": "IANA name, e.g. Europe/Berlin – for due times, reminders, birthdays and day boundaries. Empty = the server’s time zone."
        },
        "default": ""
      },
      {
        "key": "notify_lang",
        "type": "select",
        "label": {
          "de": "Sprache der Benachrichtigungen",
          "en": "Notification language"
        },
        "help": {
          "de": "Welche Funktionen eingeschaltet sind, legst du auf der Seite „Funktionen“ fest; jede Person kann Themen im Portal oder in der App abschalten.",
          "en": "Which features are on is set on the page “Features”; everyone can switch topics off in the portal or the app."
        },
        "options": [
          {
            "value": "de",
            "label": "Deutsch"
          },
          {
            "value": "en",
            "label": "English"
          }
        ],
        "default": "de"
      },
      {
        "key": "lat",
        "type": "text",
        "label": {
          "de": "Breitengrad des Zuhauses",
          "en": "Latitude of the home"
        },
        "help": {
          "de": "Für die Regel-Bedingung „nach Sonnenuntergang“ und „Zuhause übernehmen“ bei den Orten (Anwesenheit & Smart Home), z. B. 50.94. Leer = Bedingung wird ignoriert.",
          "en": "For the rule condition “after sunset” and “Use home” for places (presence & smart home), e.g. 50.94. Empty = the condition is ignored."
        },
        "default": ""
      },
      {
        "key": "lon",
        "type": "text",
        "label": {
          "de": "Längengrad des Zuhauses",
          "en": "Longitude of the home"
        },
        "help": {
          "de": "z. B. 6.96 – zusammen mit dem Breitengrad.",
          "en": "e.g. 6.96 – together with the latitude."
        },
        "default": ""
      }
    ],
    "portal": {
      "label": {
        "de": "Familie",
        "en": "Family"
      },
      "icon": "M3 11l9-7 9 7M5 10v10h14V10M10 20v-5h4v5"
    },
    "app": {
      "label": {
        "de": "Familie",
        "en": "Family"
      },
      "icon": "M3 11l9-7 9 7M5 10v10h14V10M10 20v-5h4v5"
    },
    "maps": true
  },
  "license": {
    "required": true
  },
  "migrations": "migrations",
  "notifyTopics": [
