    {
      "id": "locate",
      "label": {
        "de": "Kinder orten",
        "en": "Locating children"
      },
      "default": true
    },
    {
      "id": "arrival",
      "label": {
        "de": "„Bin angekommen“",
        "en": "“I’ve arrived”"
      },
      "default": true
    },
    {
