{
  "id": "gatecontrol-skoda",
  "name": {
    "de": "Fahrzeuge",
    "en": "Vehicles"
  },
  "version": "1.6.0",
  "publisher": "CallMeTechie",
  "description": {
    "de": "Škoda-Fahrzeuge über MySkoda einbinden: Ladestand, Reichweite, Zustand, Position und Fahrzeugdetails sehen, Klima, Laden, Scheibenheizung, Ver- und Entriegeln und Abfahrtstimer steuern und Fahrzeuge Haushaltsmitgliedern zuweisen (Portal „Fahrzeug“).",
    "en": "Connect Škoda vehicles through MySkoda: see charge level, range, condition, location and vehicle details, control climate, charging, window heating, locking and departure timers, and assign vehicles to household members (portal “Vehicle”)."
  },
  "gatecontrol": ">=1.186.0",
  "entry": "server/index.js",
  "permissions": {
    "network": {
      "internet": [
        "identity.vwgroup.io:443",
        "mysmob.api.connect.skoda-auto.cz:443",
        "iprenders.blob.core.windows.net:443",
        "*.azureedge.net:443",
        "*.skoda-auto.cz:443",
        "nominatim.openstreetmap.org:443",
        "routing.openstreetmap.de:443"
      ]
    },
    "storage": true,
    "portal": true,
    "users": true,
    "app": true,
    "notify": true,
    "background": {
      "intervalSeconds": 60
    }
  },
  "ui": {
    "nav": {
      "label": {
        "de": "Fahrzeuge",
        "en": "Vehicles"
      },
      "icon": "M5 16l1-5 2-3h8l2 3 1 5v3h-2a2 2 0 0 1-4 0H9a2 2 0 0 1-4 0H3v-3zM7.5 17.5h.01M16.5 17.5h.01"
    },
    "pages": [
      {
        "id": "main",
        "title": {
          "de": "Fahrzeuge",
          "en": "Vehicles"
        }
      },
      {
        "id": "logbook",
        "title": {
          "de": "Fahrtenbuch",
          "en": "Logbook"
        }
      }
    ],
    "settings": [
      {
        "key": "interval",
        "type": "number",
        "label": {
          "de": "Abrufintervall (Minuten)",
          "en": "Poll interval (minutes)"
        },
        "help": {
          "de": "Wie oft Zustand, Ladestand und Position aller Fahrzeuge aus der Škoda-Cloud gelesen werden (5–1440). Zu häufige Abfragen führen zu einer Sperre durch Škoda.",
          "en": "How often the state, charge level and location of all vehicles are read from the Škoda cloud (5–1440). Polling too often gets the account rate-limited by Škoda."
        },
        "min": 5,
        "max": 1440,
        "default": 15
      },
      {
        "key": "notify_battery_low",
        "type": "number",
        "label": {
          "de": "Benachrichtigung „Akku niedrig“ unter (%)",
          "en": "“Battery low” notification below (%)"
        },
        "help": {
          "de": "Einmal pro Entladung, wenn der Ladestand eines Fahrzeugs unter diesen Wert fällt (5–80). Wer die Benachrichtigung bekommt, legst du in GateControl unter System › Benachrichtigungen fest.",
          "en": "Once per discharge, when a vehicle's charge level drops below this value (5–80). Who gets it is set in GateControl under System › Notifications."
        },
        "min": 5,
        "max": 80,
        "default": 20
      },
      {
        "key": "notify_unlocked_min",
        "type": "number",
        "label": {
          "de": "Benachrichtigung „Nicht verriegelt“ nach (Minuten)",
          "en": "“Not locked” notification after (minutes)"
        },
        "help": {
          "de": "Wenn ein Fahrzeug länger als diese Zeit entriegelt ist (5–720). Das Thema ist anfangs aus – abonnieren im Portal oder in der App.",
          "en": "When a vehicle stays unlocked longer than this (5–720). The topic is off by default – subscribe in the portal or the app."
        },
        "min": 5,
        "max": 720,
        "default": 15
      },
      {
        "key": "logbook_default",
        "type": "select",
        "label": {
          "de": "Fahrtenbuch: Zweck neuer Fahrten",
          "en": "Logbook: purpose of new trips"
        },
        "help": {
          "de": "Welchen Zweck eine automatisch erfasste Fahrt bekommt. „Offen“: die Besitzer des Fahrzeugs bekommen nach jeder Fahrt eine Benachrichtigung mit den Knöpfen Privat / Geschäftlich / Arbeitsweg.",
          "en": "Which purpose a recorded trip gets. “Open”: the vehicle’s owners get a notification after every trip with the buttons Private / Business / Commute."
        },
        "options": [
          {
            "value": "open",
            "label": {
              "de": "Offen – nachfragen",
              "en": "Open – ask"
            }
          },
          {
            "value": "private",
            "label": {
              "de": "Privat",
              "en": "Private"
            }
          },
          {
            "value": "business",
            "label": {
              "de": "Geschäftlich",
              "en": "Business"
            }
          },
          {
            "value": "commute",
            "label": {
              "de": "Arbeitsweg",
              "en": "Commute"
            }
          }
        ],
        "default": "open"
      },
      {
        "key": "notify_lang",
        "type": "select",
        "label": {
          "de": "Sprache der Benachrichtigungen",
          "en": "Notification language"
        },
        "options": [
          {
            "value": "de",
            "label": "Deutsch"
          },
          {
            "value": "en",
            "label": "English"
          }
        ],
        "default": "de"
      }
    ],
    "portal": {
      "sections": [
        {
          "id": "skoda",
          "tab": "car",
          "title": {
            "de": "Fahrzeuge",
            "en": "Vehicles"
          },
          "order": 20
        },
        {
          "id": "logbook",
          "tab": "car",
          "title": {
            "de": "Fahrtenbuch",
            "en": "Logbook"
          },
          "order": 30
        }
      ]
    },
    "maps": true
  },
  "license": {
    "required": true
  },
  "migrations": "migrations",
  "notifyTopics": [
    {
      "id": "charging_done",
      "label": {
        "de": "Laden abgeschlossen",
        "en": "Charging complete"
      },
      "default": true
    },
    {
      "id": "battery_low",
      "label": {
        "de": "Akku niedrig",
        "en": "Battery low"
      },
      "default": true
    },
    {
      "id": "not_locked",
      "label": {
        "de": "Fahrzeug nicht verriegelt",
        "en": "Vehicle not locked"
      },
      "default": false
    },
    {
      "id": "climate_done",
      "label": {
        "de": "Klimatisierung fertig",
        "en": "Climate control done"
      },
      "default": false
    },
    {
      "id": "trip",
      "label": {
        "de": "Fahrt erfasst (Fahrtenbuch)",
        "en": "Trip recorded (logbook)"
      },
      "default": true
    }
  ]
}
