{
  "id": "gatecontrol-drive",
  "name": {
    "de": "Drive",
    "en": "Drive"
  },
  "version": "1.1.0",
  "publisher": "CallMeTechie",
  "description": {
    "de": "Dateien der Familie und des Teams auf dem eigenen Speicher – auf diesem Server, einer NAS oder in S3: Meine Dateien, Familie, Ordner der Kinder und Team-Ordner mit Rechten, Versionen, Papierkorb und Abgleich mit allen Geräten.",
    "en": "Files of the family and the team on your own storage – on this server, a NAS or S3: my files, family, the children's folders and team folders with rights, versions, a trash and sync with every device."
  },
  "gatecontrol": ">=1.208.0",
  "entry": "server/index.js",
  "permissions": {
    "storage": true,
    "users": true,
    "app": true,
    "portal": true,
    "events": true,
    "publicLinks": true,
    "groups": "read",
    "notify": {
      "perHour": 60
    },
    "background": {
      "intervalSeconds": 300
    }
  },
  "storage": {
    "maxMB": 4096
  },
  "media": {
    "maxBytes": 107374182400,
    "types": [
      "*/*"
    ],
    "quotaDefault": "100TB",
    "uploads": true,
    "resumable": true,
    "areas": true,
    "previews": true
  },
  "ui": {
    "portal": {
      "label": {
        "de": "Drive",
        "en": "Drive"
      },
      "icon": "M7 18h10a4 4 0 0 0 .5-8A6 6 0 0 0 6 9.5 4.3 4.3 0 0 0 7 18z"
    },
    "settings": [
      {
        "key": "versions_days",
        "type": "number",
        "label": {
          "de": "Versionen aufbewahren (Tage)",
          "en": "Keep versions (days)"
        },
        "help": {
          "de": "Ältere Fassungen einer Datei werden danach gelöscht.",
          "en": "Older versions of a file are deleted after that."
        },
        "default": 30,
        "min": 1,
        "max": 3650
      },
      {
        "key": "versions_max",
        "type": "number",
        "label": {
          "de": "Höchstens Versionen je Datei",
          "en": "At most versions per file"
        },
        "default": 25,
        "min": 1,
        "max": 500
      },
      {
        "key": "trash_days",
        "type": "number",
        "label": {
          "de": "Papierkorb leeren nach (Tagen)",
          "en": "Empty the trash after (days)"
        },
        "default": 30,
        "min": 1,
        "max": 3650
      },
      {
        "key": "mine_quota_gb",
        "type": "number",
        "label": {
          "de": "Meine Dateien: Platz je Person (GB)",
          "en": "My files: space per person (GB)"
        },
        "help": {
          "de": "0 = ohne eigene Grenze.",
          "en": "0 = no limit of its own."
        },
        "default": 50,
        "min": 0,
        "max": 100000
      },
      {
        "key": "child_parents_view",
        "type": "boolean",
        "label": {
          "de": "Eltern dürfen die Ordner der Kinder ansehen",
          "en": "Parents may look into the children's folders"
        },
        "help": {
          "de": "Das Kind bekommt dann einmal am Tag den Hinweis, wer hineingesehen hat.",
          "en": "The child then gets a note once a day saying who looked."
        },
        "default": true
      },
      {
        "key": "backup_hint",
        "type": "boolean",
        "label": {
          "de": "Hinweis: Das GateControl-Backup sichert keine Drive-Dateien",
          "en": "Hint: GateControl's backup holds no Drive files"
        },
        "help": {
          "de": "Auffällig, solange ein Bereich nur auf diesem Server oder einer NAS liegt (dann einmal pro Woche auch als Mitteilung an Admins); dezent, wenn alles in S3 liegt.",
          "en": "Prominent while an area lies only on this server or a NAS (then also once a week as a notification to administrators); subtle when everything lies in S3."
        },
        "default": true
      }
    ],
    "pages": [
      {
        "id": "overview",
        "title": {
          "de": "Übersicht",
          "en": "Overview"
        }
      },
      {
        "id": "people",
        "title": {
          "de": "Personen",
          "en": "People"
        }
      },
      {
        "id": "teams",
        "title": {
          "de": "Team-Ordner",
          "en": "Team folders"
        }
      }
    ],
    "nav": {
      "label": {
        "de": "Drive",
        "en": "Drive"
      },
      "icon": "M7 18h10a4 4 0 0 0 .5-8A6 6 0 0 0 6 9.5 4.3 4.3 0 0 0 7 18z"
    }
  },
  "license": {
    "required": true
  },
  "migrations": "migrations",
  "notifyTopics": [
    {
      "id": "child_view",
      "label": {
        "de": "Jemand hat in meinen Ordner gesehen",
        "en": "Someone looked into my folder"
      },
      "default": true
    },
    {
      "id": "link_upload",
      "label": {
        "de": "Jemand hat über meinen Link etwas hochgeladen",
        "en": "Someone uploaded through my link"
      },
      "default": true
    },
    {
      "id": "backup_hint",
      "label": {
        "de": "Drive-Dateien sind nicht gesichert (Admins)",
        "en": "Drive files are not backed up (administrators)"
      },
      "default": true
    }
  ],
  "services": {
    "provides": {
      "list_areas": {
        "label": {
          "de": "Drive-Bereiche einer Person",
          "en": "A person's Drive areas"
        }
      },
      "save_file": {
        "label": {
          "de": "Datei in Drive ablegen",
          "en": "Save a file in Drive"
        }
      }
    }
  }
}
