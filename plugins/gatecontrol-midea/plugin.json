{
  "id": "gatecontrol-midea",
  "name": {
    "de": "Raumklima",
    "en": "Indoor climate"
  },
  "version": "1.6.0",
  "publisher": "CallMeTechie",
  "description": {
    "de": "Klimageräte und Heizungen steuern: Midea-Klimageräte über die Midea-Cloud oder im Heimnetz, Dreo-Heizlüfter und -Klimageräte live über die Dreo-Cloud (Ein/Aus, Zieltemperatur, Modus, Lüfter, Schwenken) – und Haushaltsmitgliedern zuweisen (Portal „Zuhause“).",
    "en": "Control air conditioners and heaters: Midea air conditioners through the Midea cloud or in the home network, Dreo heaters and air conditioners live through the Dreo cloud (on/off, target temperature, mode, fan, oscillation) – and assign them to household members (portal “Home”)."
  },
  "gatecontrol": ">=1.154.0",
  "entry": "server/index.js",
  "permissions": {
    "network": {
      "internet": [
        "mp-prod.appsmb.com:443",
        "mapp.appsmb.com:443",
        "app-api-eu.dreo-tech.com:443",
        "app-api-us.dreo-tech.com:443",
        "wsb-eu.dreo-tech.com:443",
        "wsb-us.dreo-tech.com:443"
      ],
      "homeTargets": [
        {
          "id": "ac",
          "label": {
            "de": "Klimagerät (Heimnetz)",
            "en": "Air conditioner (home network)"
          },
          "protocols": [
            "tcp:6444",
            "udp:6445,20086"
          ],
          "multiple": true
        }
      ],
      "localDiscovery": {
        "udp": [
          6445,
          20086
        ]
      }
    },
    "storage": true,
    "portal": true,
    "users": true,
    "notify": true,
    "background": {
      "intervalSeconds": 30
    }
  },
  "ui": {
    "nav": {
      "label": {
        "de": "Raumklima",
        "en": "Indoor climate"
      },
      "icon": "M10 13V5a2 2 0 1 1 4 0v8a4 4 0 1 1-4 0zM12 9v6"
    },
    "pages": [
      {
        "id": "main",
        "title": {
          "de": "Raumklima",
          "en": "Indoor climate"
        }
      }
    ],
    "settings": [
      {
        "key": "notify_lang",
        "type": "select",
        "label": {
          "de": "Sprache der Benachrichtigungen",
          "en": "Notification language"
        },
        "help": {
          "de": "Wer welche Benachrichtigung bekommt, legst du in GateControl unter System › Benachrichtigungen fest; jede Person kann Themen im Portal oder in der App abschalten.",
          "en": "Who gets which notification is set in GateControl under System › Notifications; everyone can switch topics off in the portal or the app."
        },
        "options": [
          {
            "value": "de",
            "label": "Deutsch"
          },
          {
            "value": "en",
            "label": "English"
          }
        ],
        "default": "de"
      }
    ],
    "portal": {
      "sections": [
        {
          "id": "midea",
          "tab": "home",
          "title": {
            "de": "Raumklima",
            "en": "Indoor climate"
          },
          "order": 10
        }
      ]
    }
  },
  "license": {
    "required": true
  },
  "migrations": "migrations",
  "notifyTopics": [
    {
      "id": "device_unreachable",
      "label": {
        "de": "Gerät nicht erreichbar",
        "en": "Device unreachable"
      },
      "default": true
    },
    {
      "id": "filter_clean",
      "label": {
        "de": "Filter reinigen",
        "en": "Clean the filter"
      },
      "default": true
    },
    {
      "id": "error_code",
      "label": {
        "de": "Störung am Klimagerät",
        "en": "Air conditioner malfunction"
      },
      "default": true
    }
  ]
}
