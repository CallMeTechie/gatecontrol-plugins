{
  "id": "gatecontrol-midea",
  "name": {
    "de": "Klimaanlage",
    "en": "Air conditioning"
  },
  "version": "1.5.0",
  "publisher": "CallMeTechie",
  "description": {
    "de": "Midea-Klimageräte über die Midea-Cloud oder im Heimnetz steuern (Ein/Aus, Zieltemperatur, Modus, Lüfter, Turbo/Eco) und Haushaltsmitgliedern zuweisen (Portal „Zuhause“).",
    "en": "Control Midea air conditioners through the Midea cloud or in the home network (on/off, target temperature, mode, fan, turbo/eco) and assign them to household members (portal “Home”)."
  },
  "gatecontrol": ">=1.154.0",
  "entry": "server/index.js",
  "permissions": {
    "network": {
      "internet": [
        "mp-prod.appsmb.com:443",
        "mapp.appsmb.com:443"
      ],
      "homeTargets": [
        {
          "id": "ac",
          "label": {
            "de": "Klimagerät (Heimnetz)",
            "en": "Air conditioner (home network)"
          },
          "protocols": [
            "tcp:6444",
            "udp:6445,20086"
          ],
          "multiple": true
        }
      ],
      "localDiscovery": {
        "udp": [
          6445,
          20086
        ]
      }
    },
    "storage": true,
    "portal": true,
    "users": true,
    "notify": true,
    "background": {
      "intervalSeconds": 30
    }
  },
  "ui": {
    "nav": {
      "label": {
        "de": "Klimaanlage",
        "en": "Air conditioning"
      },
      "icon": "M2 4h20v10H2zM6 9h12M6 18v1M10 18v2M14 18v2M18 18v1"
    },
    "pages": [
      {
        "id": "main",
        "title": {
          "de": "Klimaanlage",
          "en": "Air conditioning"
        }
      }
    ],
    "settings": [
      {
        "key": "notify_lang",
        "type": "select",
        "label": {
          "de": "Sprache der Benachrichtigungen",
          "en": "Notification language"
        },
        "help": {
          "de": "Wer welche Benachrichtigung bekommt, legst du in GateControl unter System › Benachrichtigungen fest; jede Person kann Themen im Portal oder in der App abschalten.",
          "en": "Who gets which notification is set in GateControl under System › Notifications; everyone can switch topics off in the portal or the app."
        },
        "options": [
          {
            "value": "de",
            "label": "Deutsch"
          },
          {
            "value": "en",
            "label": "English"
          }
        ],
        "default": "de"
      }
    ],
    "portal": {
      "sections": [
        {
          "id": "midea",
          "tab": "home",
          "title": {
            "de": "Klimaanlage",
            "en": "Air conditioning"
          },
          "order": 10
        }
      ]
    }
  },
  "license": {
    "required": true
  },
  "migrations": "migrations",
  "notifyTopics": [
    {
      "id": "device_unreachable",
      "label": {
        "de": "Klimagerät nicht erreichbar",
        "en": "Air conditioner unreachable"
      },
      "default": true
    },
    {
      "id": "filter_clean",
      "label": {
        "de": "Filter reinigen",
        "en": "Clean the filter"
      },
      "default": true
    },
    {
      "id": "error_code",
      "label": {
        "de": "Störung am Klimagerät",
        "en": "Air conditioner malfunction"
      },
      "default": true
    }
  ]
}
